# Copy to .env for local development. Never commit real secrets.
NODE_ENV=development
PORT=4000
LOG_LEVEL=info
# Proxies in front of the API in production (1 on Vercel)
TRUST_PROXY_HOPS=1
# Named (security) rate limits: memory | postgres. Default: postgres in production, memory otherwise
# RATE_LIMIT_STORE=memory

# PostgreSQL (docker compose `pnpm db:up` uses these credentials)
DATABASE_URL=postgresql://vtmp:vtmp@localhost:5432/vtmp?schema=public
TEST_DATABASE_URL=postgresql://vtmp:vtmp@localhost:5432/vtmp_test?schema=public
# Production only (Vercel): direct, non-pooled Neon URL used by migrations in the build
# DIRECT_DATABASE_URL=

# Auth (generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))")
JWT_SECRET=change-me-dev-only-access-secret-at-least-32-chars
REFRESH_SECRET=change-me-dev-only-refresh-secret-at-least-32-chars
# bcrypt cost: TAD §9 requires 12 (never below 10 outside tests)
BCRYPT_ROUNDS=12

# Public base URL used in certificate QR codes. Fix it before the first deploy and never change it.
PUBLIC_BASE_URL=http://localhost:5173

# Comma-separated browser origins allowed to call the API
CORS_ORIGINS=http://localhost:5173

# File storage: local disk (dev). Production uses an object store reachable from Vercel, chosen in Sprint 6
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./storage
STORAGE_BUCKET=
STORAGE_ENDPOINT=
STORAGE_REGION=auto
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=

# AI Training Assistant (Release 3, off by default)
AI_ENABLED=false
ANTHROPIC_API_KEY=
AI_MONTHLY_CAP=0

# Web (Vite exposes only VITE_* variables to the browser)
VITE_API_BASE_URL=/api/v1
