{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "pnpm install --frozen-lockfile --production=false",
  "buildCommand": "sh scripts/vercel-build.sh",
  "outputDirectory": "apps/web/dist",
  "regions": ["sin1"],
  "functions": {
    "api/index.js": {
      "maxDuration": 30,
      "includeFiles": "{node_modules/.pnpm/@prisma+client*/node_modules/.prisma/client/**,node_modules/.pnpm/pdfkit@*/node_modules/pdfkit/js/data/**,apps/api/assets/**}"
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api" },
    { "source": "/health", "destination": "/api" },
    { "source": "/verify", "destination": "/verify.html" },
    { "source": "/verify/(.*)", "destination": "/verify.html" },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    }
  ]
}
