{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "types": ["vite/client", "node"],
    "noEmit": true,
    "baseUrl": "../..",
    "paths": {
      "@vtmp/shared": ["packages/shared/src/index.ts"]
    }
  },
  "include": [
    "src",
    "e2e",
    "docs-screens",
    "vite.config.ts",
    "playwright.config.ts",
    "playwright.docs.config.ts",
    "tailwind.config.ts"
  ]
}
